{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "BL PAB",
  "version": "1.8.1",
  "description": "__MSG_description__",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.bricklink.com/*",
    "https://www.lego.com/*",
    "https://api.frankfurter.app/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bricklink.com/v2/catalog/catalogitem.page*",
        "https://www.bricklink.com/catalogItem.asp*"
      ],
      "js": [
        "src/i18n.js",
        "src/colors.js",
        "src/data.js",
        "src/bricklink.js"
      ],
      "css": [
        "src/bricklink.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.lego.com/*/pick-and-build/pick-a-brick*"
      ],
      "js": [
        "src/pab-fetch.js",
        "src/lego.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_name__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en"
}